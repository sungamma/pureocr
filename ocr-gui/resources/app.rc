#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "ocrgui.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,11,0,0
 PRODUCTVERSION 0,11,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ocr-gui"
            VALUE "FileDescription", "PDF OCR - PDF to searchable PDF"
            VALUE "InternalName", "ocrgui"
            VALUE "OriginalFilename", "ocrgui.exe"
            VALUE "ProductName", "PDF OCR"
            VALUE "ProductVersion", "0.11.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
