#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APPICON ICON "pureocr.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION PUREOCR_VERSION_COMMA
 PRODUCTVERSION PUREOCR_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PureOCR"
            VALUE "FileDescription", "PureOCR - PDF to searchable PDF"
            VALUE "InternalName", "pureocr"
            VALUE "OriginalFilename", "pureocr.exe"
            VALUE "ProductName", "PureOCR"
            VALUE "ProductVersion", PUREOCR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
