#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APPICON ICON "ocrgui.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OCRGUI_VERSION_COMMA
 PRODUCTVERSION OCRGUI_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ocr-gui"
            VALUE "FileDescription", "PDF OCR - PDF to searchable PDF"
            VALUE "InternalName", "ocrgui"
            VALUE "OriginalFilename", "ocrgui.exe"
            VALUE "ProductName", "PDF OCR"
            VALUE "ProductVersion", OCRGUI_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
